conda_name=omniroute

# Copy this file to .env in the same directory as compose.yml. .env is
# gitignored — never commit it.

# Pin a real released version, not :latest — check
# https://hub.docker.com/r/diegosouzapw/omniroute/tags
OMNIROUTE_VERSION=3.8.50

# Required: gates the whole gateway behind an API key. Since this compose
# file publishes ports on 0.0.0.0 for multi-machine access, this MUST stay
# true — see the comment in compose.yml.
REQUIRE_API_KEY=true

# Bind address for the dashboard/API/websocket ports. Leave at 0.0.0.0 for
# multi-machine access (paired with REQUIRE_API_KEY=true above), or set to
# 127.0.0.1 if you only ever want this reachable from the Docker host itself.
APP_BIND_HOST=0.0.0.0

# Container-internal listen addresses for the API and live-WS servers —
# separate from APP_BIND_HOST above, which only controls the Docker
# host-side port publish. Verified against upstream source
# (src/lib/apiBridgeServer.ts): these default to 127.0.0.1 inside the
# container, so without setting them here too, `omniroute connect` from
# another machine would silently fail (API/WS unreachable) even though the
# dashboard loads fine — the dashboard's own bind address is baked into the
# image separately and doesn't need this. Safe to widen only because
# REQUIRE_API_KEY=true above (matches upstream's own boot-time exposure
# guard condition). Set both back to 127.0.0.1 if you ever set
# APP_BIND_HOST back to 127.0.0.1 too.
API_HOST=0.0.0.0
LIVE_WS_HOST=0.0.0.0

# Node heap ceiling. 1024 (image default) is fine for dashboard/light chat
# only. Coding agents (Claude Code, Codex) need much more or the process
# FATAL ERRORs under long/concurrent contexts.
OMNIROUTE_MEMORY_MB=8192
# Container memory limit — size above the heap above (native buffers sit
# outside V8's own accounting). ~10g for one coding agent, 12-16g for two
# concurrent long sessions.
OMNIROUTE_CONTAINER_MEM=10g

# Ports (defaults shown — only change if something else on the host uses these)
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132

# First-boot dashboard login password. Set this before first `docker compose
# up` if you want a real password from the start — see compose.yml. Not the
# same thing as the OmniRoute API key generated later via the dashboard.
# INITIAL_PASSWORD=

# ── Obsidian ──────────────────────────────────────────────────────────
# Deliberately NOT an env var here, because OmniRoute doesn't read one.
# The Local REST API base URL lives in OmniRoute's own settings store
# (verified in upstream source: src/lib/db/obsidian.ts keeps it under
# namespace "obsidian", key "base_url"; src/lib/obsidian/api.ts falls back
# to DEFAULT_OBSIDIAN_BASE_URL = "http://127.0.0.1:27123" when unset).
# Anything you put in this file is ignored for that setting.
#
# Set it once from the dashboard (or POST /api/settings/obsidian) to:
#   http://obsidian:27123
# NOT 127.0.0.1 — that is the omniroute container's own loopback, and the
# plugin lives in the separate `obsidian` container. Leaving the default in
# place is what produces `[ProxyFetch] ... connect ECONNREFUSED
# 127.0.0.1:27123` in the omniroute logs. See compose.yml and the README
# for the two plugin-side settings ("Enable HTTP server", binding host
# 0.0.0.0) that also have to be changed.
